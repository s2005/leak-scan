{
  "version": 1,
  "categories": [
    {
      "name": "identity",
      "description": "Author identity markers: handle, name, personal address.",
      "rules": [
        {
          "label": "author handle",
          "pattern": "example-handle"
        },
        {
          "label": "author given name",
          "pattern": "example-given-name"
        },
        {
          "label": "author surname",
          "pattern": "example-surname"
        },
        {
          "label": "personal address",
          "pattern": "example\\.personal@example\\.com"
        }
      ]
    },
    {
      "name": "employer",
      "description": "Employer name and internal project/host references.",
      "rules": [
        {
          "label": "employer name",
          "pattern": "\\bexample-corp\\b"
        },
        {
          "label": "employer name",
          "pattern": "example\\s+parent\\s+co"
        },
        {
          "label": "internal jira project",
          "pattern": "exampleproj"
        },
        {
          "label": "internal project name",
          "pattern": "example-ci-pipeline"
        },
        {
          "label": "internal jira host",
          "pattern": "internal\\.example\\.com"
        }
      ]
    },
    {
      "name": "affiliation",
      "description": "Corporate-context wording that should not appear in a public repo.",
      "rules": [
        {
          "label": "corporate-context wording",
          "pattern": "internal tooling"
        },
        {
          "label": "corporate-context wording",
          "pattern": "organi[sz]ation'?s policy"
        }
      ]
    },
    {
      "name": "machine",
      "description": "Drive-rooted local paths and unix home directories.",
      "rules": [
        {
          "label": "drive-rooted local path",
          "pattern": "[A-Za-z]:[\\\\/](Users|Work|mcp)\\b"
        },
        {
          "label": "unix home directory path",
          "pattern": "/home/[A-Za-z0-9_.-]+/"
        }
      ],
      "allow": {
        "context": [
          "/mnt/[a-z]/",
          "/home/(?:user|youruser|runner|me|<[^>]+>)/"
        ]
      }
    },
    {
      "name": "docs_tasks",
      "description": "Any surviving reference to an untracked task tree.",
      "rules": [
        {
          "label": "reference to deleted tree",
          "pattern": "docs/tasks"
        }
      ]
    },
    {
      "name": "credential",
      "description": "password / token / secret / api_key assignments whose value is not a placeholder.",
      "rules": [
        {
          "label": "credential assignment",
          "pattern": "(?:password|passwd|pwd|token|secret|api[_-]?key)\\s*[:=]\\s*(?P<value>[\\\"'`]?[^\\s\\\"'`,;()]+[\\\"'`]?)"
        }
      ],
      "allow": {
        "values": [
          "change_me",
          "changeme",
          "your_password",
          "your-password",
          "password",
          "secret",
          "token",
          "none",
          "null",
          "true",
          "false",
          ""
        ],
        "value_patterns": [
          "^\\$\\{.*\\}$",
          "^\\$[A-Za-z_][A-Za-z0-9_]*$",
          "^%[A-Za-z_][A-Za-z0-9_]*%$",
          "^<.*>$",
          "^[A-Za-z_][A-Za-z0-9_.]*$",
          "^\\{\\{.*\\}\\}$",
          "^\\*+$"
        ],
        "min_value_length": 6,
        "require_letter_and_digit": true
      }
    },
    {
      "name": "api_key_prefix",
      "description": "Recognizable API key and access-token prefixes.",
      "rules": [
        {
          "label": "GitHub token",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])(?:ghp_|github_pat_|gho_|ghu_|ghs_|ghr_)[A-Za-z0-9_]{16,})(?![A-Za-z0-9_])",
          "ignore_case": false
        },
        {
          "label": "GitLab token",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])(?:glpat-|gloas-|gldt-|glrt-|glrtr-|glcbt-|glptt-|glft-|glimt-|glagent-|glwt-|glsoat-|glffct-)[A-Za-z0-9_-]{16,})(?![A-Za-z0-9_-])",
          "ignore_case": false
        },
        {
          "label": "AWS access key ID",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])(?:AKIA|ASIA)[A-Z0-9]{16})(?![A-Z0-9])",
          "ignore_case": false
        },
        {
          "label": "Stripe secret or restricted key",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])(?:sk_(?:test|live|org)_|rk_(?:test|live)_)[A-Za-z0-9_]{12,})(?![A-Za-z0-9_])",
          "ignore_case": false
        },
        {
          "label": "Slack token",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])(?:xox[bapr]-|xoxe[.-])[A-Za-z0-9_.-]{12,})(?![A-Za-z0-9_.-])",
          "ignore_case": false
        },
        {
          "label": "OpenAI API key",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])(?:sk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|sk-(?!ant-)[A-Za-z0-9]{20,}))(?![A-Za-z0-9_-])",
          "ignore_case": false
        },
        {
          "label": "Anthropic API key",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])sk-ant-(?:api03|admin01)-[A-Za-z0-9_-]{20,})(?![A-Za-z0-9_-])",
          "ignore_case": false
        },
        {
          "label": "Groq API key",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])gsk_[A-Za-z0-9_-]{20,})(?![A-Za-z0-9_-])",
          "ignore_case": false
        },
        {
          "label": "Hugging Face token",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])(?:hf_|api_org_)[A-Za-z0-9_-]{20,})(?![A-Za-z0-9_-])",
          "ignore_case": false
        },
        {
          "label": "Perplexity API key",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])pplx-[A-Za-z0-9]{20,})(?![A-Za-z0-9])",
          "ignore_case": false
        },
        {
          "label": "DigitalOcean token",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])(?:dop_v1_|doo_v1_|dor_v1_)[A-Za-z0-9_-]{16,})(?![A-Za-z0-9_-])",
          "ignore_case": false
        },
        {
          "label": "Databricks token",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])dapi[a-f0-9]{32}(?:-[0-9])?)(?![A-Za-z0-9])",
          "ignore_case": false
        },
        {
          "label": "npm token",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])npm_[A-Za-z0-9]{20,})(?![A-Za-z0-9])",
          "ignore_case": false
        },
        {
          "label": "PyPI token",
          "pattern": "(?P<value>(?<![A-Za-z0-9_])pypi-[A-Za-z0-9_-]{20,})(?![A-Za-z0-9_-])",
          "ignore_case": false
        }
      ]
    }
  ],
  "path_allow": [],
  "binary_suffixes": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".ico",
    ".pdf",
    ".zip",
    ".gz",
    ".jar",
    ".xlsx",
    ".class",
    ".so",
    ".dll",
    ".exe"
  ]
}
